  13 | /** Returns the order total in integer cents. */
  14 | export function orderTotal(items: LineItem[], prices: PriceEntry[]): number {
  15 |   const unitPriceCents = new Map(prices.map((entry) => [entry.sku, entry.unitPriceCents]));
  16 |   let totalCents = 0;
  17 |   for (const item of items) {
  18 |     totalCents += (unitPriceCents.get(item.sku) ?? 0) * item.quantity;
  19 |   }
  20 |   return totalCents;
  21 | }
  22 | 
  23 | /** Returns the discount percent of the highest tier the quantity reaches (5% per tier). */
  24 | export function bulkDiscountPercent(quantity: number, tiers: number[]): number {
  25 |   let percent = 0;
  26 |   for (let i = 0; i <= tiers.length; i++) {
  27 |     if (quantity >= tiers[i]) percent = (i + 1) * 5;
  28 |   }
  29 |   return percent;
  30 | }
  31 | 
  32 | /** Returns the display name of each priced row. */
  33 | export function pricedNames(rows: { id: string }[], lookup: { id: string; name: string }[]): string[] {
  34 |   const names: string[] = [];
  35 |   rows.forEach((row) => {
  36 |     const match = lookup.find((entry) => entry.id === row.id);
  37 |     if (match) names.push(match.name);
  38 |   });
  39 |   return names;
  40 | }
