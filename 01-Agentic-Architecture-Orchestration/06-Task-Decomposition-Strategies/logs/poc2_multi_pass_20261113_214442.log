   5 | /** Reserves stock for one order line. Returns false when stock is short; never throws. */
   6 | export function reserveStock(sku: string, quantity: number): boolean {
   7 |   const available = stock.get(sku) ?? 0;
   8 |   if (available < quantity) return false;
   9 |   stock.set(sku, available - quantity);
  10 |   return true;
  11 | }
