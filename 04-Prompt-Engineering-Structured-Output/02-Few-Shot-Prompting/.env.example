# Copy this file to .env (same folder) and fill in your values:
#     cp .env.example .env
# Every POC script reads .env at start-up. Never share or commit .env: it holds your secret key.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=your-api-key-here

# The Claude model that runs the agent.
MODEL_ID=claude-sonnet-5-5

# POC 2 safety cap: the most tool-use turns one run may take before the SDK stops it.
MAX_TURNS=5

# Cost guard: the SDK stops a single run once its estimated spend passes this many US dollars.
MAX_BUDGET_USD=0.50
