# Your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=your-api-key-here
# The model that runs every agent; the explorer subagents inherit it (model="inherit")
MODEL_ID=claude-sonnet-5-5
# Cost guard per query() call, subagents included: the SDK stops a call whose estimated spend passes this
MAX_BUDGET_USD=1.00
