# Your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=your-api-key-here
# The Claude model that runs the support agent
MODEL_ID=claude-sonnet-5-5
# Cost guard per run: the SDK stops a run whose estimated spend passes this
MAX_BUDGET_USD=0.50
# Safety cap on tool-use turns per run; a normal run needs far fewer
MAX_TURNS=15
