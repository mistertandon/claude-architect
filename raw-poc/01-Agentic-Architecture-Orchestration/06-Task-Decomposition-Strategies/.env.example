# Your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=your-api-key-here
# The model for EVERY review pass: the same model in both POCs, so the difference is the structure
MODEL_ID=claude-sonnet-5-5
# Cost guard per review call: the SDK stops a call whose estimated spend passes this
MAX_BUDGET_USD=0.50
# Safety cap on turns per review call; a review needs only a few
MAX_TURNS=10
