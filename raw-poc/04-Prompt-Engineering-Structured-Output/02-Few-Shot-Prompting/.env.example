# Your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=your-api-key-here
# The model for every extraction: the same model in every arm, so only the examples change
MODEL_ID=claude-sonnet-5-5
# Cost guard per extraction call: the SDK stops a call whose estimated spend passes this
MAX_BUDGET_USD=0.50
# Safety cap on turns per extraction call
MAX_TURNS=5
