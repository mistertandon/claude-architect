# Your Anthropic API key (never commit .env); POC 2's anthropic client reads it from the environment too
ANTHROPIC_API_KEY=your-api-key-here
# The model for POC 1's extractions (POC 2 always uses claude-haiku-5-5: see FORCED_MODEL in poc2_tool_choice.py)
MODEL_ID=claude-sonnet-5-5
# Cost guard per POC 1 call: the SDK stops a call whose estimated spend passes this
MAX_BUDGET_USD=0.50
# Safety cap on turns per POC 1 call, with room for schema retries
MAX_TURNS=10
