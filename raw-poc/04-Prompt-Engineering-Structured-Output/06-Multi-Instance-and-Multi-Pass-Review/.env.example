# Your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=your-api-key-here
# The model for every review pass and both verifiers (self-review and independent)
MODEL_ID=claude-sonnet-5-5
# Cost guard per call: the SDK stops a call whose estimated spend passes this
MAX_BUDGET_USD=0.50
# Safety cap on turns per call
MAX_TURNS=10
